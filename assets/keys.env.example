# blog-image-finder keys. Copy to ~/.config/blog-image-finder/keys.env and chmod 600.
# Every line is optional: sources without a key are skipped.

# Stock photos
PEXELS_API_KEY=
PIXABAY_API_KEY=
UNSPLASH_ACCESS_KEY=
UNSPLASH_APP_NAME=

# AI generation, last resort
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
NVIDIA_API_KEY=
POLLINATIONS_TOKEN=

# HTTP service: require "Authorization: Bearer <token>" when set
BIF_SERVER_TOKEN=
